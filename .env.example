# Copy to .env for local development (`npx wrangler dev` and `node ai/test-live.mjs` read it). .env is git-ignored.
# In production set the key as a Cloudflare secret instead: npx wrangler secret put GEMINI_API_KEY

# Google AI Studio API key (https://aistudio.google.com/apikey).
# Create it in a Google Cloud project WITHOUT billing → the Free Tier only, it cannot be charged.
GEMINI_API_KEY=

# Site origins allowed to call the worker, comma-separated.
ALLOWED_ORIGINS=http://localhost:8000

# Optional: Gemini model (default gemini-3.1-flash-lite).
GEMINI_MODEL=gemini-3.1-flash-lite
